{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "usersCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "expenses": {
        "ClusterId": "expensesCluster",
        "Match": {
          "Path": "/api/expenses/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "auth": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "usersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5180/"
          }
        }
      },
      "expensesCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5115/"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5228/"
          }
        }
      }
    }
  }
}